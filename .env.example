# Copy to .env and fill in values

# Data source: "api" uses ClinicalTrials.gov REST API (no credentials needed)
#              "postgres" uses AACT mirror database
DATA_SOURCE=api

# ClinicalTrials.gov API settings (only used when DATA_SOURCE=api)
CT_API_BASE=https://clinicaltrials.gov/api/v2
CT_API_PAGE_SIZE=1000
CT_API_MAX_PAGES=5

# AACT PostgreSQL (only used when DATA_SOURCE=postgres)
DB_USER=your_aact_username
DB_PASS=your_aact_password
DB_HOST=aact-db.ctti-clinicaltrials.org
DB_PORT=5432
DB_NAME=aact
